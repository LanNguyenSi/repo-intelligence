{
  "name": "repo-dashboard",
  "version": "0.1.0",
  "description": "CLI dashboard for GitHub repositories: PRs, pipelines, issues at a glance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "repo-dash": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/cli.js",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "github",
    "dashboard",
    "cli",
    "repos",
    "developer-tools"
  ],
  "author": "Lan Nguyen Si",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "overrides": {
    "picomatch": ">=4.0.4",
    "postcss": "^8.5.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LanNguyenSi/repo-intelligence.git",
    "directory": "packages/repo-dashboard"
  }
}

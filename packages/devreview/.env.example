# GitHub Token Configuration
GITHUB_TOKEN=your-github-token
WEBHOOK_SECRET=your-webhook-secret

# Server Configuration
PORT=3000
# Read by Express, not by DevReview; production keeps stack traces out of error responses
NODE_ENV=production
DEVREVIEW_CONFIG=.devreview.json

# Optional: explicit config path override
# DEVREVIEW_CONFIG=./config/devreview.json
